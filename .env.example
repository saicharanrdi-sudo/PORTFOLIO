# Web3Forms access key for the "Book a call" form (https://web3forms.com)
NEXT_PUBLIC_WEB3FORMS_KEY=

# Password for /admin. Leave empty to keep the admin open on localhost only.
ADMIN_PASSWORD=

# Vercel only: connect a Blob store to the project (Storage → Blob) and this is
# added automatically. Content and uploads persist there instead of on disk.
BLOB_READ_WRITE_TOKEN=
